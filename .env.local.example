# Copier en .env.local puis renseigner. Ce fichier-ci est un modèle sans secret ;
# .env.local est ignoré par git et ne doit jamais être versionné.

# OBLIGATOIRE. Chaîne de connexion Postgres.
# Supabase → Project Settings → Database → Connection string → « Transaction pooler »
# (port 6543). Remplacez [YOUR-PASSWORD] par le mot de passe de la base.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Mot de passe de l'administration. Sans lui, le mot de passe est « piment »
# et un bandeau d'avertissement s'affiche sur la page de connexion.
# OBLIGATOIRE avant toute mise en ligne.
ADMIN_PASSWORD=

# Secret de signature des cookies de session. Par défaut il est dérivé du mot de
# passe : changer le mot de passe invalide alors les sessions ouvertes.
# En production, mettez une valeur longue et aléatoire.
SESSION_SECRET=
